<Window x:Class="AlpacaDashboard.Views.SymbolChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AlpacaDashboard.Views"
        Title="{Binding Symbol, StringFormat='{}{0} · Alpaca Dashboard'}" Width="1100" Height="720" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}">
    <Border Style="{StaticResource Card}" Margin="14">
        <views:SymbolChartView />
    </Border>
</Window>
