<Window x:Class="AlpacaDashboard.Views.TradePositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlpacaDashboard.ViewModels"
        Title="{Binding Symbol, StringFormat='Trade {0} · Alpaca Dashboard'}" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}">
    <Window.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource KpiLabel}" />
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,10" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Header -->
        <DockPanel>
            <Border DockPanel.Dock="Right" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                        <Setter Property="BorderBrush" Value="{StaticResource GridlineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiveAccount}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}">
                    <Run Text="{Binding AccountName, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding ModeLabel, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Symbol}" FontSize="24" FontWeight="SemiBold" />
                <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource GridlineBrush}" Margin="12,0,0,0">
                    <TextBlock Text="{Binding SideLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}" />
                </Border>
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14" Foreground="{StaticResource SecondaryBrush}">
                    <Run Text="{Binding Row.Qty, Mode=OneWay, StringFormat='0.#########'}" /> <Run Text="{Binding QtyUnit, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Position details -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Style="{StaticResource DetailLabel}">
                        <Run Text="Price" />
                        <Run Text="● live" Foreground="{StaticResource GoodBrush}" FontSize="10" />
                    </TextBlock>
                    <TextBlock Text="{Binding Row.PriceText}" Style="{StaticResource DetailValue}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="Avg entry" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Row.AvgEntryText}" Style="{StaticResource DetailValue}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Today" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Row.ChangeToday, Converter={StaticResource Signed}, ConverterParameter=P}" Style="{StaticResource DetailValue}"
                               Foreground="{Binding Row.ChangeToday, Converter={StaticResource SignBrush}}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Market value" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Row.MarketValue, StringFormat=C2}" Style="{StaticResource DetailValue}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="Unrealized P/L" Style="{StaticResource DetailLabel}" />
                    <TextBlock Style="{StaticResource DetailValue}" Margin="0,2,0,0" Foreground="{Binding Row.UnrealizedPl, Converter={StaticResource SignBrush}}">
                        <Run Text="{Binding Row.UnrealizedPl, Converter={StaticResource Signed}, Mode=OneWay}" />
                        <Run Text="{Binding Row.UnrealizedPlPct, Converter={StaticResource Signed}, ConverterParameter=P, StringFormat='({0})', Mode=OneWay}" FontSize="12" FontWeight="Normal" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2"
                            ToolTip="Qty not tied up by open orders. Sells beyond this are rejected until those orders are cancelled.">
                    <TextBlock Text="Available to close" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Row.QtyAvailable, StringFormat='0.#########'}" Style="{StaticResource DetailValue}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Open orders on this symbol -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0"
                Visibility="{Binding SymbolOrders.Count, Converter={StaticResource NotEmptyToVisibility}}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}">
                    <Run Text="Open orders on" /> <Run Text="{Binding Symbol, Mode=OneWay}" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding SymbolOrders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource ChipButton}" Margin="8,0,0,0"
                                        Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SecondaryBrush}" ToolTip="{Binding Status}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Mode selector -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Padding="3" Margin="0,14,0,0" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Button Content="Liquidate" Style="{StaticResource RangeButton}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:TradeMode.Liquidate}"
                        Tag="{Binding IsLiquidate}" />
                <Button Style="{StaticResource RangeButton}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:TradeMode.SellQty}"
                        Tag="{Binding IsSellQty}">
                    <TextBlock><Run Text="{Binding CloseVerb, Mode=OneWay}" /> <Run Text="amount" /></TextBlock>
                </Button>
                <Button Content="Stop limit" Style="{StaticResource RangeButton}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static vm:TradeMode.StopLimit}"
                        Tag="{Binding IsStopLimit}" />
            </StackPanel>
        </Border>

        <!-- Liquidate -->
        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsLiquidate, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" FontSize="12"
                       Text="Closes the entire position with a market order. Outside market hours it queues for the next open (stocks)." />
            <CheckBox Margin="0,10,0,0" Foreground="{StaticResource InkBrush}" IsChecked="{Binding CancelOrdersFirst}"
                      Visibility="{Binding SymbolOrders.Count, Converter={StaticResource NotEmptyToVisibility}}">
                <TextBlock><Run Text="Cancel the open orders on" /> <Run Text="{Binding Symbol, Mode=OneWay}" /> <Run Text="first" /></TextBlock>
            </CheckBox>
        </StackPanel>

        <!-- Sell amount -->
        <StackPanel Margin="0,4,0,0" Visibility="{Binding IsSellQty, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="25%" Style="{StaticResource ChipButton}" Command="{Binding SetSellFractionCommand}" CommandParameter="0.25" />
                    <Button Content="50%" Style="{StaticResource ChipButton}" Command="{Binding SetSellFractionCommand}" CommandParameter="0.5" />
                    <Button Content="75%" Style="{StaticResource ChipButton}" Command="{Binding SetSellFractionCommand}" CommandParameter="0.75" />
                    <Button Content="All" Style="{StaticResource ChipButton}" Command="{Binding SetSellFractionCommand}" CommandParameter="1" Margin="0" />
                </StackPanel>
                <TextBox Text="{Binding SellQtyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton Content="Market" GroupName="SellType" Foreground="{StaticResource InkBrush}" IsChecked="True" Margin="0,0,18,0" />
                <RadioButton Content="Limit" GroupName="SellType" Foreground="{StaticResource InkBrush}" IsChecked="{Binding SellIsLimit}" />
            </StackPanel>

            <Grid Margin="0,2,0,0" Visibility="{Binding SellIsLimit, Converter={StaticResource NotEmptyToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Limit price" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SellLimitText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Time in force" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding TifOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding SellTif}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Stop limit -->
        <StackPanel Margin="0,4,0,0" Visibility="{Binding IsStopLimit, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Content="50%" Style="{StaticResource ChipButton}" Command="{Binding SetStopFractionCommand}" CommandParameter="0.5" />
                    <Button Content="All" Style="{StaticResource ChipButton}" Command="{Binding SetStopFractionCommand}" CommandParameter="1" Margin="0" />
                </StackPanel>
                <TextBox Text="{Binding StopQtyText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
            </DockPanel>

            <TextBlock Text="Set stop from current price" Style="{StaticResource FieldLabel}" />
            <StackPanel Orientation="Horizontal">
                <Button Content="1%" Style="{StaticResource ChipButton}" Command="{Binding SetStopOffsetCommand}" CommandParameter="0.01" />
                <Button Content="2%" Style="{StaticResource ChipButton}" Command="{Binding SetStopOffsetCommand}" CommandParameter="0.02" />
                <Button Content="5%" Style="{StaticResource ChipButton}" Command="{Binding SetStopOffsetCommand}" CommandParameter="0.05" />
                <Button Content="10%" Style="{StaticResource ChipButton}" Command="{Binding SetStopOffsetCommand}" CommandParameter="0.1" />
                <Button Content="Break-even" Style="{StaticResource ChipButton}" Command="{Binding SetStopOffsetCommand}" CommandParameter="entry"
                        ToolTip="Stop at your average entry price" />
            </StackPanel>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Stop (trigger) price" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding StopPriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Limit price" Style="{StaticResource FieldLabel}"
                               ToolTip="Once the stop triggers, the order becomes a limit order at this price" />
                    <TextBox Text="{Binding StopLimitText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Time in force" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding TifOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding StopTif}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Preview -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding Preview.Count, Converter={StaticResource NotEmptyToVisibility}}">
            <ItemsControl ItemsSource="{Binding Preview}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PreviewLine}">
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12" Width="170" />
                            <TextBlock Text="{Binding Value}" TextAlignment="Right" TextWrapping="Wrap" FontSize="13" Typography.NumeralAlignment="Tabular">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Signed, Converter={StaticResource SignBrush}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Signed}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Estimates use the live price; actual fills and fees may differ."
                   Visibility="{Binding Preview.Count, Converter={StaticResource NotEmptyToVisibility}}" />

        <!-- Messages -->
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BadBrush}"
                   Text="{Binding Problem, StringFormat='✕ {0}'}" Visibility="{Binding Problem, Converter={StaticResource NotEmptyToVisibility}}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarnBrush}"
                   Text="{Binding Warning, StringFormat='⚠ {0}'}" Visibility="{Binding Warning, Converter={StaticResource NotEmptyToVisibility}}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Text="{Binding Status}"
                   Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Actions -->
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{Binding SubmitLabel}" Command="{Binding SubmitCommand}" Margin="8,0,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiquidate}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BadBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="OnClose" Style="{StaticResource GhostButton}" />
        </DockPanel>
    </StackPanel>
</Window>
