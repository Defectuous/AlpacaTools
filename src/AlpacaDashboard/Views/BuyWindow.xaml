<Window x:Class="AlpacaDashboard.Views.BuyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AlpacaDashboard.ViewModels"
        Title="{Binding Symbol, StringFormat='Buy {0} · Alpaca Dashboard'}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}">
    <Window.Resources>
        <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Header -->
        <DockPanel>
            <Border DockPanel.Dock="Right" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                        <Setter Property="BorderBrush" Value="{StaticResource GridlineBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLiveAccount}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}">
                    <Run Text="{Binding AccountName, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding ModeLabel, Mode=OneWay}" />
                </TextBlock>
            </Border>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Symbol}" FontSize="24" FontWeight="SemiBold" />
                <Border Style="{StaticResource Badge}" BorderBrush="{StaticResource GridlineBrush}" Margin="12,0,0,0">
                    <TextBlock Text="BUY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryBrush}" />
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Price and buying power -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource KpiLabel}">
                        <Run Text="Price" /> <Run Text="{Binding PriceNote, Mode=OneWay}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                    </TextBlock>
                    <TextBlock Text="{Binding PriceText}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <StackPanel Grid.Column="1" ToolTip="Crypto can't be bought on margin, so crypto buys use cash-only buying power">
                    <TextBlock Text="Buying power" Style="{StaticResource KpiLabel}" />
                    <TextBlock Text="{Binding BuyingPower, StringFormat=C2, TargetNullValue='—'}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Text="{Binding HeldText}" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource AccentBrush}"
                   Visibility="{Binding HeldText, Converter={StaticResource NotEmptyToVisibility}}" />

        <!-- Amount -->
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <RadioButton Content="Dollars" GroupName="BuyUnit" Foreground="{StaticResource InkBrush}" IsChecked="{Binding InDollars}" Margin="0,0,18,0" />
            <RadioButton GroupName="BuyUnit" Foreground="{StaticResource InkBrush}">
                <RadioButton.Style>
                    <Style TargetType="RadioButton">
                        <Setter Property="Content" Value="Shares" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCrypto}" Value="True">
                                <Setter Property="Content" Value="Quantity" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RadioButton.Style>
            </RadioButton>
        </StackPanel>
        <DockPanel Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="$100" Style="{StaticResource ChipButton}" Command="{Binding SetDollarsCommand}" CommandParameter="100" />
                <Button Content="$500" Style="{StaticResource ChipButton}" Command="{Binding SetDollarsCommand}" CommandParameter="500" />
                <Button Content="$1k" Style="{StaticResource ChipButton}" Command="{Binding SetDollarsCommand}" CommandParameter="1000" />
                <Button Content="$5k" Style="{StaticResource ChipButton}" Command="{Binding SetDollarsCommand}" CommandParameter="5000" Margin="0" />
            </StackPanel>
            <TextBox x:Name="AmountBox" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <RadioButton Content="Market" GroupName="BuyType" Foreground="{StaticResource InkBrush}" IsChecked="True" Margin="0,0,18,0" />
            <RadioButton Content="Limit" GroupName="BuyType" Foreground="{StaticResource InkBrush}" IsChecked="{Binding IsLimit}" />
        </StackPanel>
        <Grid Margin="0,2,0,0" Visibility="{Binding IsLimit, Converter={StaticResource NotEmptyToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Limit price" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding LimitText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Time in force" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{Binding TifOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Tif}" />
            </StackPanel>
        </Grid>

        <!-- Preview -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding Preview.Count, Converter={StaticResource NotEmptyToVisibility}}">
            <ItemsControl ItemsSource="{Binding Preview}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PreviewLine}">
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12" Width="170" />
                            <TextBlock Text="{Binding Value}" TextAlignment="Right" TextWrapping="Wrap" FontSize="13" Typography.NumeralAlignment="Tabular">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Signed, Converter={StaticResource SignBrush}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Signed}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Estimates use the price above; actual fills and fees may differ."
                   Visibility="{Binding Preview.Count, Converter={StaticResource NotEmptyToVisibility}}" />

        <!-- Messages -->
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BadBrush}"
                   Text="{Binding Problem, StringFormat='✕ {0}'}" Visibility="{Binding Problem, Converter={StaticResource NotEmptyToVisibility}}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarnBrush}"
                   Text="{Binding Warning, StringFormat='⚠ {0}'}" Visibility="{Binding Warning, Converter={StaticResource NotEmptyToVisibility}}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Text="{Binding Status}"
                   Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Actions -->
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="{Binding SubmitLabel}" Command="{Binding SubmitCommand}" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" />
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Click="OnClose" Style="{StaticResource GhostButton}" />
        </DockPanel>
    </StackPanel>
</Window>
