<UserControl x:Class="AlpacaDashboard.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AlpacaDashboard.Views">
    <DockPanel>
        <!-- New alert -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="New price alert" Style="{StaticResource CardTitle}" />
                <WrapPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Symbol" Style="{StaticResource FieldLabel}" />
                        <views:SymbolSearchBox DataContext="{Binding Search}" Width="260" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Condition" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Conditions}" SelectedItem="{Binding NewCondition}" DisplayMemberPath="Label"
                                  Style="{StaticResource DarkCombo}" Width="190" Height="28" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Style="{StaticResource FieldLabel}">
                            <Run Text="Value" /><Run Text="{Binding NewTargetUnit, Mode=OneWay, StringFormat=' ({0})'}" />
                        </TextBlock>
                        <TextBox Text="{Binding NewTarget, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Width="110" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Note (optional)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputBox}" Width="240"
                                 ToolTip="Shown in the notification, e.g. &quot;buy more&quot; or &quot;check the news&quot;" />
                    </StackPanel>
                    <Button Content="+ Add alert" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                </WrapPanel>
                <TextBlock Text="{Binding NewSymbolText}" Foreground="{StaticResource SecondaryBrush}" FontSize="12" Margin="0,10,0,0" />
                <TextBlock Text="Position alerts follow the P/L of your position in the account on screen, and keep doing so when you switch accounts."
                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                           Visibility="{Binding NewCondition.IsPositionBased, Converter={StaticResource NotEmptyToVisibility}}" />
                <TextBlock Text="{Binding NewWarning}" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,4,0,0"
                           Visibility="{Binding NewWarning, Converter={StaticResource NotEmptyToVisibility}}" />
                <TextBlock Text="{Binding FormError}" Foreground="{StaticResource BadBrush}" FontSize="12" Margin="0,4,0,0"
                           Visibility="{Binding FormError, Converter={StaticResource NotEmptyToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- Alert list -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="Clear fired" Command="{Binding ClearTriggeredCommand}" Style="{StaticResource GhostButton}"
                            ToolTip="Remove every alert that has already fired" />
                    <TextBlock Text="Alerts" Style="{StaticResource CardTitle}" />
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding Status, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="No alerts yet. Pick a symbol above, or use a position's Alert button. Each alert fires once, as a Windows notification, then waits to be re-armed."
                           Visibility="{Binding Alerts.Count, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=Invert}" />
                <DataGrid ItemsSource="{Binding Alerts}" Style="{StaticResource DarkGrid}"
                          Visibility="{Binding Alerts.Count, Converter={StaticResource NotEmptyToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Symbol" Binding="{Binding Symbol, Mode=OneWay}" Width="Auto" MinWidth="80" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Alert when" Binding="{Binding ConditionText, Mode=OneWay}" Width="Auto" />
                        <DataGridTextColumn Header="Price" Binding="{Binding PriceText, Mode=OneWay}" SortMemberPath="CurrentPrice" Width="Auto" ElementStyle="{StaticResource NumCell}" />
                        <DataGridTemplateColumn Header="Today" Width="Auto" SortMemberPath="DayChange">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumCell}" Text="{Binding DayChange, Converter={StaticResource Signed}, ConverterParameter=P}"
                                               Foreground="{Binding DayChange, Converter={StaticResource SignBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="P/L" Width="Auto" SortMemberPath="Pl">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource NumCell}" Text="{Binding PlText}" Foreground="{Binding Pl, Converter={StaticResource SignBrush}}"
                                               ToolTip="Unrealized P/L of the position: in the alert's account for P/L alerts, otherwise in the account on screen" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Distance" Binding="{Binding DistanceText, Mode=OneWay}" Width="Auto"
                                            ElementStyle="{StaticResource NumCell}" Foreground="{StaticResource SecondaryBrush}" />
                        <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="IsArmed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Note" Binding="{Binding Alert.Note, Mode=OneWay}" Width="*" Foreground="{StaticResource SecondaryBrush}" />
                        <DataGridTemplateColumn Header="" Width="Auto" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Re-arm" Style="{StaticResource GhostButton}" Padding="8,1" FontSize="11" Margin="0,0,6,0"
                                                ToolTip="Watch again. If the condition is still true, it fires on the next check."
                                                Command="{Binding DataContext.RearmCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsArmed, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=Invert}" />
                                        <Button Content="Delete" Style="{StaticResource GhostButton}" Padding="8,1" FontSize="11"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
