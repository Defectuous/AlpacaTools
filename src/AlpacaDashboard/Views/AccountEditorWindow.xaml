<Window x:Class="AlpacaDashboard.Views.AccountEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alpaca account" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" />

        <TextBlock Text="API key ID" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="KeyIdBox" Style="{StaticResource InputBox}" FontFamily="Consolas" />

        <TextBlock Text="API secret key" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="SecretBox" Style="{StaticResource InputPassword}" FontFamily="Consolas" />

        <CheckBox x:Name="PaperCheck" Content="Paper trading account" Margin="0,14,0,0"
                  Foreground="{StaticResource InkBrush}" />

        <CheckBox x:Name="BotPriorityCheck" Margin="0,10,0,0" Foreground="{StaticResource InkBrush}">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Shared with a bot: give it priority" FontWeight="SemiBold" />
                <LineBreak />
                <Run Foreground="{StaticResource MutedBrush}" FontSize="12"
                     Text="No streams on this key (the bot keeps Alpaca's stream slot), prices polled every 15s, and the dashboard backs off when the key's request budget is half used." />
            </TextBlock>
        </CheckBox>

        <TextBlock Text="Market data plan" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="PlanCombo" SelectedIndex="0">
            <ComboBoxItem Content="Auto-detect (recommended)" />
            <ComboBoxItem Content="Basic (free): IEX live, SIP charts 15-min delayed" />
            <ComboBoxItem Content="Algo Trader Plus: real-time SIP" />
        </ComboBox>

        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                   Text="Keys are stored encrypted for your Windows user (DPAPI). Orders are placed only from a position's Trade window, after you confirm. Live prices and price charts use your Alpaca market data plan. Generate keys on the Alpaca dashboard; paper and live accounts have separate keys." />

        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Test connection" Click="OnTest" Style="{StaticResource GhostButton}" />
            <Button DockPanel.Dock="Right" Content="Save" Click="OnSave" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Style="{StaticResource GhostButton}" />
        </DockPanel>
    </StackPanel>
</Window>
